# Copié et rempli par l'installation. Ne partagez jamais config.env.
PROVIDER="codex"
AGENT_NAME="Mon assistant"
TELEGRAM_TOKEN=""
TELEGRAM_OWNER_ID=""
TELEGRAM_CHAT_ID=""
WORKSPACE="workspace"
# Facultatif : chemin du CLI si la détection automatique échoue.
CODEX_BIN=""
CLAUDE_BIN=""
# Vide = modèle par défaut du moteur choisi.
CODEX_MODEL=""
CLAUDE_MODEL=""
# Claude : autoriser aussi les commandes locales (droits de votre compte).
ALLOW_SHELL="0"
TURN_TIMEOUT="900"
