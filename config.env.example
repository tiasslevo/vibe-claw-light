# Exemple pour une nouvelle installation. Ne partagez jamais config.env.
PROVIDER="codex"
AGENT_NAME="Mon assistant"
TELEGRAM_TOKEN=""
TELEGRAM_OWNER_ID=""
TELEGRAM_CHAT_ID=""
# Dossier où ranger les nouveaux travaux, distinct des permissions.
WORKSPACE="~/Documents/MonAssistant"
# personal : dossier utilisateur + installation + WORKSPACE ; commandes et réseau.
# workspace : installation + WORKSPACE ; réseau Codex désactivé.
# Une ancienne config sans ACCESS_MODE conserve le mode workspace.
ACCESS_MODE="personal"
# Liste JSON de dossiers absolus supplémentaires, 12 maximum.
# Exemple Windows : EXTRA_DIRS='["D:/Projets", "E:/Documents"]'
EXTRA_DIRS="[]"
# Facultatif : chemin du CLI si la détection automatique échoue.
CODEX_BIN=""
CLAUDE_BIN=""
# Vide = modèle par défaut du moteur choisi.
CODEX_MODEL=""
CLAUDE_MODEL=""
# Claude en mode workspace : autoriser les commandes avec les droits du compte.
# Le mode personal les active dans tous les cas.
ALLOW_SHELL="1"
TURN_TIMEOUT="900"
